---
import '../styles/global.css';
import BaseHead from '../components/BaseHead.astro';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';

interface Props {
  title: string;
  description: string;
  image?: string;
}

const { title, description, image } = Astro.props;
const _ogImageProp = (Astro.props as any).ogImage; /* og-wiring */

---

<!doctype html>
<html lang="en">
  <head>
    <BaseHead ogImage={_ogImageProp} title={title} description={description} image={image} />
    <script
      type="application/ld+json"
      set:html={JSON.stringify({
        "@context": "https://schema.org",
        "@type": "WebSite",
        "name": "AI Select",
        "url": "https://aiselect.ai",
        "description": "Independent AI tool reviews for better software decisions, plus a free SecureFlow workflow Snapshot for Australian and cross-border SMEs.",
        "inLanguage": "en"
      })}
    />
  </head>
  <body class="font-sans text-[#0F0F1B] bg-white antialiased min-h-screen flex flex-col">
    <Header />
    <main class="flex-1">
      <slot />
    </main>
    <Footer />
    <script src="https://go.compares.cheap/f.js" data-site="aiselect-ai" async></script>
  </body>
</html>
