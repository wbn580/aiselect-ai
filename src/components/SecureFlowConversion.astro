---
const formUrl = 'https://chat.arrivau.com/go-form?form=automation&site=aiselect-ai&lang=en&embed=1';
---

<section id="snapshot" class="relative scroll-mt-24">
  <div class="absolute inset-x-0 -top-28 h-52 bg-[radial-gradient(circle_at_50%_50%,rgba(0,217,192,.13),transparent_68%)] pointer-events-none"></div>
  <div class="relative max-w-6xl mx-auto px-6">
    <div class="mb-8 max-w-2xl">
      <p class="font-mono text-xs font-bold tracking-[0.18em] uppercase text-[#008f80]">Free · rules-based · 5–8 minutes</p>
      <h2 class="mt-3 text-3xl lg:text-4xl font-mono font-bold tracking-tight text-[#14172c]">Get the route before you buy anything.</h2>
      <p class="mt-4 text-[#5b6375] leading-relaxed">The snapshot measures workflow value, remote feasibility and data guardrails. It returns, narrows or declines a route automatically. It does not collect passwords, tokens or files.</p>
    </div>
    <div class="rounded-[26px] border border-[#dce8e6] bg-[#f3f7f7] p-2.5 lg:p-4 shadow-[0_30px_90px_-52px_rgba(20,23,44,.62)]">
      <iframe
        id="secureflow-assessment"
        src={formUrl}
        title="SecureFlow workflow and data-risk snapshot"
        class="block w-full min-h-[1040px] rounded-[20px] border-0 bg-[#f3f7f7]"
        loading="eager"
        referrerpolicy="strict-origin-when-cross-origin"
      ></iframe>
    </div>
    <p class="mt-4 text-xs leading-relaxed text-[#7a8290]">Self-reported screening only — not an audit, certification, penetration test or legal opinion. Active or suspected cyber incidents are routed out of the sales funnel.</p>
  </div>
</section>

<script is:inline>
  (function () {
    var frame = document.getElementById('secureflow-assessment');
    if (!frame) return;
    var formOrigin = 'https://chat.arrivau.com';
    function attribution() {
      var a = {};
      try { if (typeof window.CCGetAttribution === 'function') a = window.CCGetAttribution() || {}; } catch (e) {}
      var q = new URLSearchParams(location.search);
      function take(k, n) { return String((a && a[k]) || q.get(k) || '').slice(0, n); }
      return {
        site_id: 'aiselect-ai', funnel_site: 'aiselect-ai', lang: 'en-AU', channel: 'form-secureflow',
        page_url: location.origin + location.pathname,
        referrer: String(a.referrer || document.referrer || '').slice(0, 300),
        utm_source: take('utm_source', 80), utm_medium: take('utm_medium', 80),
        utm_campaign: take('utm_campaign', 80), utm_content: take('utm_content', 80),
        utm_term: take('utm_term', 80), vid: String(a.vid || window.CCV || '').slice(0, 64),
        current_source: String(a.current_source || '').slice(0, 40),
        first_source: String(a.first_source || '').slice(0, 40)
      };
    }
    function sendAttribution() {
      try { frame.contentWindow.postMessage({ type: 'arrivau:attribution', attribution: attribution() }, formOrigin); } catch (e) {}
    }
    frame.addEventListener('load', sendAttribution);
    window.addEventListener('message', function (event) {
      if (event.origin !== formOrigin || event.source !== frame.contentWindow) return;
      var data = event.data || {};
      if (data.type === 'arrivau:form_ready') sendAttribution();
      if (data.type === 'arrivau:snapshot_route') {
        try {
          if (typeof window.CCTrack === 'function') window.CCTrack('snapshot_route', { c: String(data.route_code || '').slice(0, 60), n: Number(data.score || 0) });
        } catch (e) {}
      }
      if (data.type === 'arrivau:lead_submit') {
        try {
          if (typeof window.CCTrack === 'function') window.CCTrack('lead_submit', { c: 'secureflow_snapshot', sid: String(data.session_id || '') });
        } catch (e) {}
      }
    });
    try { if (typeof window.CCTrack === 'function') window.CCTrack('snapshot_view', { c: 'secureflow' }); } catch (e) {}
  })();
</script>
