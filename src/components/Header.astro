---
const links = [
  ['Reviews', '/#reviews'],
  ['Categories', '/category/'],
  ['Methodology', '/methodology/'],
  ['SecureFlow', '/services/secureflow/'],
  ['About', '/about/'],
];
---

<header class="sticky top-0 z-50 bg-[#1A1A2E]/95 backdrop-blur-sm border-b border-white/[0.06]">
  <div class="max-w-6xl mx-auto px-6">
    <div class="flex items-center h-16 gap-10">
      <a href="/" class="flex items-center gap-2 shrink-0">
        <span class="w-7 h-7 rounded-md bg-[#00D9C0]/15 flex items-center justify-center">
          <span class="text-[#00D9C0] text-sm font-mono font-bold">&gt;_</span>
        </span>
        <span class="font-mono font-bold text-base text-white tracking-tight">aiselect</span>
      </a>
      <details class="relative ml-auto xl:hidden">
        <summary class="list-none min-h-11 min-w-11 inline-flex items-center justify-center cursor-pointer rounded-md border border-white/15 text-xs font-mono font-bold text-white" aria-label="Open navigation">Menu</summary>
        <div class="absolute right-0 top-full mt-2 w-52 rounded-lg border border-white/10 bg-[#1A1A2E] p-2 shadow-xl flex flex-col z-20">
          {links.map(([label, href]) => (
            <a href={href} class="min-h-11 px-3 inline-flex items-center text-sm text-gray-300 hover:text-white hover:bg-white/5 rounded-md">{label}</a>
          ))}
        </div>
      </details>
      <nav class="hidden xl:flex gap-8" data-cw-nav>
        {links.map(([label, href]) => (
          <a href={href} class="text-sm text-gray-400 hover:text-white transition-colors font-medium">{label}</a>
        ))}
      </nav>
      <button type="button" data-cw-burger aria-expanded="false" aria-label="打开主导航"
              class="xl:hidden inline-flex flex-col justify-center items-center gap-1.5"
              style="width:44px;height:44px;color:inherit;background:none;border:0;cursor:pointer">
        <span style="display:block;width:24px;height:2px;background:currentColor"></span>
        <span style="display:block;width:24px;height:2px;background:currentColor"></span>
        <span style="display:block;width:24px;height:2px;background:currentColor"></span>
      </button>
    </div>
  </div>
</header>

<style>


  /* MENU-CROWD-FIX-20260708: keep dense desktop menus from wrapping or crushing CTA buttons. */
  header nav a,
  .nav-links a,
  .nav-link,
  .nav-cta,
  .site-nav a {
    white-space: nowrap;
  }
  .nav-links,
  .site-nav {
    min-width: 0;
  }
  .site-nav.flex-wrap,
  nav.site-nav.flex-wrap {
    flex-wrap: nowrap;
    overflow-x: auto;
    -webkit-overflow-scrolling: touch;
    scrollbar-width: none;
  }
  .site-nav.flex-wrap::-webkit-scrollbar,
  nav.site-nav.flex-wrap::-webkit-scrollbar {
    display: none;
  }
</style>

<script>
  // 2026-09-01 手机主导航不可达修复：本模板家族的主导航是 Tailwind 的 `hidden xl:flex`，
  // 断点以下整块消失，而且**根本没有**汉堡按钮 —— 手机上除首页外没有任何入口。
  // 这里补一个断点以下才显示的按钮，用行内样式把同一个 <nav> 翻成下拉面板
  // （行内 style 覆盖 Tailwind 的 .hidden，不必复制一份菜单标记）。
  (() => {
    const b = document.querySelector('[data-cw-burger]');
    const n = document.querySelector('[data-cw-nav]');
    if (!b || !n) return;
    const bar = b.closest('header') || b.parentElement;
    const LINK = ['padding', 'minHeight', 'display', 'alignItems'];
    const set = (on) => {
      const links = n.querySelectorAll('a');
      if (on) {
        const r = bar.getBoundingClientRect();
        Object.assign(n.style, {
          display: 'flex', flexDirection: 'column', alignItems: 'stretch', gap: '0',
          position: 'fixed', left: '0', right: '0', top: Math.max(0, r.bottom) + 'px',
          zIndex: '60', background: '#fff', padding: '6px 18px 12px',
          boxShadow: '0 10px 30px -18px rgba(0,0,0,.45)',
          maxHeight: 'calc(100vh - 60px)', overflowY: 'auto',
        });
        links.forEach((a) => {
          a.style.padding = '13px 2px'; a.style.minHeight = '44px';
          a.style.display = 'flex'; a.style.alignItems = 'center';
        });
      } else {
        n.removeAttribute('style');
        links.forEach((a) => LINK.forEach((k) => { a.style[k] = ''; }));
      }
      b.setAttribute('aria-expanded', String(on));
      b.setAttribute('aria-label', on ? '\u5173\u95ed\u4e3b\u5bfc\u822a' : '\u6253\u5f00\u4e3b\u5bfc\u822a');
    };
    const isOpen = () => b.getAttribute('aria-expanded') === 'true';
    b.addEventListener('click', () => set(!isOpen()));
    n.addEventListener('click', (e) => { if (e.target.closest('a')) set(false); });
    window.addEventListener('resize', () => {
      if (!isOpen()) return;
      if (getComputedStyle(b).display === 'none') set(false); else set(true);
    });
  })();
</script>
